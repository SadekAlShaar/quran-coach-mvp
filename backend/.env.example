# Required for real word-level transcription
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Comma-separated frontend origins. Use your Vercel URL in production.
CORS_ORIGINS=http://localhost:3000

# Optional future Quran-Lab adapter endpoint.
# It should accept multipart audio + expected_text and return phoneme/tajweed JSON.
QURAN_MODEL_ENDPOINT=
QURAN_MODEL_TOKEN=
